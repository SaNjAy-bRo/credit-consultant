<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="100%" height="100%">
  <defs>
    <!-- Deep Royal Navy to Teal Gradient -->
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0b1329" />
      <stop offset="50%" stop-color="#1e3a8a" />
      <stop offset="100%" stop-color="#0f766e" />
    </linearGradient>

    <!-- Upward Trending Growth Arrow Gradient -->
    <linearGradient id="arrowGrad" x1="0%" y1="100%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#00BC7D" />
      <stop offset="50%" stop-color="#38bdf8" />
      <stop offset="100%" stop-color="#60a5fa" />
    </linearGradient>

    <!-- Glow Effect -->
    <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="10" stdDeviation="14" flood-color="#00BC7D" flood-opacity="0.4" />
    </filter>
  </defs>

  <!-- Outer Rounded Shield / App Icon Box -->
  <rect x="24" y="24" width="464" height="464" rx="116" fill="url(#bgGrad)" />

  <!-- Subtle Border Accent -->
  <rect x="40" y="40" width="432" height="432" rx="100" fill="none" stroke="#ffffff" stroke-width="5" stroke-opacity="0.15" />

  <!-- Shield Outline Background -->
  <path d="M256 88 C312 88 360 108 376 124 C376 248 340 348 256 400 C172 348 136 248 136 124 C152 108 200 88 256 88 Z"
        fill="#ffffff" fill-opacity="0.04" stroke="#38bdf8" stroke-width="12" stroke-linejoin="round" opacity="0.35" />

  <!-- Rising CIBIL / Credit Trend Arrow -->
  <g filter="url(#glow)">
    <path d="M140 336 L216 260 L276 320 L372 200"
          fill="none" stroke="url(#arrowGrad)" stroke-width="34" stroke-linecap="round" stroke-linejoin="round" />

    <path d="M304 200 H372 V268"
          fill="none" stroke="url(#arrowGrad)" stroke-width="34" stroke-linecap="round" stroke-linejoin="round" />

    <!-- Sparkle & Node Dots -->
    <circle cx="372" cy="200" r="18" fill="#ffffff" />
    <circle cx="216" cy="260" r="12" fill="#00BC7D" />
    <circle cx="276" cy="320" r="12" fill="#38bdf8" />
  </g>

  <!-- Bottom Verification Badge -->
  <circle cx="256" cy="424" r="14" fill="#00BC7D" />
  <path d="M250 424 L254 428 L262 420" fill="none" stroke="#ffffff" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" />
</svg>
