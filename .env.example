# Credit Consultant - Environment Variables & Service Configuration Template

# -----------------------------------------------------------------------------
# 1. API Services (Individual & Bureau Report Pulling)
# Primary API Endpoint: https://api.avmanagement.in/v1
# Admin Panel: https://rsfintech.in/admin
# -----------------------------------------------------------------------------
VITE_CREDIT_API_URL=https://api.avmanagement.in/v1
VITE_CREDIT_API_TOKEN=rsf_81f8550480e63c146ea9b55fada8b717deeb342d

# -----------------------------------------------------------------------------
# 2. SMS Gateway Configuration (Fast2SMS)
# Required for live phone number OTP verification.
# (If left empty, runs in dev mode using console/in-memory OTP logging)
# -----------------------------------------------------------------------------
VITE_FAST2SMS_KEY=your_fast2sms_authorization_key

# -----------------------------------------------------------------------------
# 3. Web & Domain Configuration
# Production Domain: https://creditconsultant.in
# Server Panel: https://cp.serverbyt.in
# -----------------------------------------------------------------------------
VITE_SITE_URL=https://creditconsultant.in
