<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="100%" height="100%">
  <defs>
    <!-- Background Gradient: Deep Slate to Royal Blue -->
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#091325" />
      <stop offset="50%" stop-color="#112446" />
      <stop offset="100%" stop-color="#0a1931" />
    </linearGradient>

    <!-- Green Bar / Arrow Gradient -->
    <linearGradient id="greenGrad" x1="0%" y1="100%" x2="0%" y2="0%">
      <stop offset="0%" stop-color="#059669" />
      <stop offset="100%" stop-color="#00BC7D" />
    </linearGradient>

    <!-- Cyan Bar Gradient -->
    <linearGradient id="cyanGrad" x1="0%" y1="100%" x2="0%" y2="0%">
      <stop offset="0%" stop-color="#0284c7" />
      <stop offset="100%" stop-color="#38bdf8" />
    </linearGradient>

    <!-- Drop Shadow for Depth -->
    <filter id="dropShadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="12" stdDeviation="16" flood-color="#000000" flood-opacity="0.6" />
      <feDropShadow dx="0" dy="6" stdDeviation="10" flood-color="#00BC7D" flood-opacity="0.3" />
    </filter>
  </defs>

  <!-- Background App Frame -->
  <rect x="24" y="24" width="464" height="464" rx="116" fill="url(#bgGrad)" />

  <!-- Subtle Glass Rim -->
  <rect x="36" y="36" width="440" height="440" rx="104" fill="none" stroke="#ffffff" stroke-width="3.5" stroke-opacity="0.15" />

  <!-- Master Logo Emblem -->
  <g filter="url(#dropShadow)">
    <!-- Protective Credit Shield Outline -->
    <path d="M256 76 C332 76 376 98 392 112 C392 240 356 348 256 408 C156 348 120 240 120 112 C136 98 180 76 256 76 Z"
          fill="#1e293b"
          fill-opacity="0.4"
          stroke="#ffffff"
          stroke-width="12"
          stroke-opacity="0.25"
          stroke-linejoin="round" />

    <!-- Ascending Credit Score Growth Bars Inside Shield -->
    <!-- Bar 1 (Initial Score) -->
    <rect x="176" y="260" width="32" height="76" rx="10" fill="url(#cyanGrad)" opacity="0.6" />

    <!-- Bar 2 (Improving Score) -->
    <rect x="240" y="200" width="32" height="136" rx="10" fill="url(#cyanGrad)" />

    <!-- Bar 3 (780+ Target Score) -->
    <rect x="304" y="140" width="32" height="196" rx="10" fill="url(#greenGrad)" />

    <!-- Overlaid Bold White Upward Trend Arrow -->
    <path d="M152 296 L224 232 L276 272 L360 160"
          fill="none"
          stroke="#ffffff"
          stroke-width="22"
          stroke-linecap="round"
          stroke-linejoin="round" />

    <path d="M308 160 H360 V212"
          fill="none"
          stroke="#ffffff"
          stroke-width="22"
          stroke-linecap="round"
          stroke-linejoin="round" />

    <!-- Verification Checkmark Badge -->
    <circle cx="360" cy="160" r="26" fill="#00BC7D" stroke="#ffffff" stroke-width="4" />
    <path d="M350 160 L357 167 L370 153" fill="none" stroke="#ffffff" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" />
  </g>
</svg>
